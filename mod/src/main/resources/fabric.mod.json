{
  "schemaVersion": 1,
  "id": "mysteries_above",
  "version": "${version}",
  "name": "Mysteries Above",
  "description": "Beyonders, Pathways and Sequences — порт плагіна mysteries-above на Fabric.",
  "authors": ["Yumeead"],
  "license": "ARR",
  "environment": "*",
  "entrypoints": {
    "main": [
      {
        "adapter": "kotlin",
        "value": "me.vangoo.mysteries.MysteriesAboveMod"
      }
    ],
    "client": [
      {
        "adapter": "kotlin",
        "value": "me.vangoo.mysteries.client.MysteriesAboveClient"
      }
    ]
  },
  "mixins": [
    "mysteries_above.mixins.json",
    {
      "config": "mysteries_above.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*",
    "fabric-language-kotlin": ">=1.13.13"
  }
}
