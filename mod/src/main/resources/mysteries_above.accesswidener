accessWidener	v2	official

# The header must be the very first line, and the namespace is `official`, not `named`: on 26.x
# the game ships unobfuscated, so the official names already are the readable ones and loom
# refuses a `named` header outright.
#
# Fool, Seq. 6 (Faceless) — Shapeshifting has to tell the other clients that this player is
# wearing someone else's face. `ClientboundPlayerInfoUpdatePacket` only ever builds its entries
# from real `ServerPlayer`s, so a fabricated `GameProfile` cannot reach it through any public
# constructor; the entry record itself is public, only the list holding it is not.
#
# This is the cheapest tool that works, and deliberately cheaper than the mixin the hook search
# order would otherwise end at: widening a member's visibility injects no code into any method
# body, so nothing here can break the way a `@Redirect` into a rewritten method would.
accessible	field	net/minecraft/network/protocol/game/ClientboundPlayerInfoUpdatePacket	entries	Ljava/util/List;
mutable	field	net/minecraft/network/protocol/game/ClientboundPlayerInfoUpdatePacket	entries	Ljava/util/List;

# Fool, Seq. 5 (Marionettist) — a mob on the threads keeps its own pathfinding and its own melee
# goals, and loses only the right to choose its enemies. That is one line, `targetSelector`, and
# vanilla keeps it protected because nothing outside a `Mob` normally rewrites another mob's will.
accessible	field	net/minecraft/world/entity/Mob	targetSelector	Lnet/minecraft/world/entity/ai/goal/GoalSelector;

# The fading text of the knowledge powers (effect/WorldText) — a vanilla text display, built from a
# tag like `/summon` builds it, whose opacity is stepped down before it goes. Opacity is synced
# entity data, but its setter is private: nothing in vanilla fades a display once it is placed.
accessible	method	net/minecraft/world/entity/Display$TextDisplay	setTextOpacity	(B)V

# The solid shaft of light (client/render/LightShaft) — a render type of the mod's own, with its own
# shader and premultiplied blending. Vanilla builds every render type through this one factory and
# keeps it package-private; there is no public way to a type that is not on its list.
accessible	method	net/minecraft/client/renderer/rendertype/RenderType	create	(Ljava/lang/String;Lnet/minecraft/client/renderer/rendertype/RenderSetup;)Lnet/minecraft/client/renderer/rendertype/RenderType;

# Restraint (ability/Restraints) — a bound player's own client refuses to move them: after the keyboard
# is read, the movement it asked for is set to nothing. The keys are a public field, the movement
# vector a protected one; nothing in vanilla ever overrules the keyboard from outside.
accessible	field	net/minecraft/client/player/ClientInput	moveVector	Lnet/minecraft/world/phys/Vec2;
